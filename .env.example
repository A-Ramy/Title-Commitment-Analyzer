# Copy to .env (gitignored) and fill in. Never commit the real file.
# Required: the Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional locally (unset = SQLite file in .data/app.db). In the cloud: the Postgres connection string.
DATABASE_URL=
# Optional: Google Sheets / Docs exports. Base64 of the service account JSON key: base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Optional: the daily email (resend.com, sending from @totalchb.com).
RESEND_API_KEY=
