# Paste into Streamlit Community Cloud: App → Settings → Secrets. Never commit the filled-in version
# (.streamlit/secrets.toml is gitignored).

# Required
ANTHROPIC_API_KEY = "sk-ant-..."
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Sign-in (required: the app is locked without one). The app is public on Streamlit Community Cloud
# (one private app per account), so it protects itself.
# Who may sign in: anyone @ALLOWED_DOMAINS plus the ALLOWED_EMAILS (comma-separated).
ALLOWED_DOMAINS = "totalchb.com"
ALLOWED_EMAILS = ""

# Option A (quick stopgap): one team password. People type their work email and the password.
APP_PASSWORD = "a long random password"

# Option B (recommended): Google sign-in. Once this section is set, it replaces the password.
# [auth]
# redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# cookie_secret = "a long random string"
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional: Google Sheets / Docs exports (base64 of the service account JSON key)
# GOOGLE_SERVICE_ACCOUNT_JSON_B64 = "..."

# Optional: daily email (also add it to the GitHub repo's Actions secrets)
# RESEND_API_KEY = "re_..."
